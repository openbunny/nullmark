; Seatbelt profile for the nullmark CLI (task4pdf.c built with -DT4_MAIN). The
; app carries no App Sandbox entitlement (README.md, "Sandbox and hardened
; runtime"), so this profile is the CLI's containment: t4_replace parses an
; untrusted PDF through MuPDF, a C parser with published memory-corruption CVEs
; (https://www.cve.org/CVERecord/SearchResults?query=mupdf), and a crafted PDF
; that gains code execution in this process cannot reach the network or write
; outside the one output path of the run.
;
; tests/test_redactor.py invokes it through sandbox-exec. BIN_PATH, IN_PATH and
; OUT_PATH must be absolute: SBPL matches a `(param ...)` value as a literal string, so a
; relative path never matches the absolute path the kernel presents.
(version 1)
(deny default)

; Process launch reads the root directory's own vnode before main() runs; without
; this rule sandbox-exec's child aborts with SIGABRT before any task4pdf.c code
; executes. A trivial libSystem-only binary under this profile reproduces it, and
; file-read-metadata alone does not suffice. The rule grants no access to any
; file below the root.
(allow file-read* (literal "/"))

; t4_replace has no network use.
(deny network*)

; Running the binary needs read access to it as well as process-exec: the kernel
; maps the Mach-O image from disk.
(allow process-exec* (literal (param "BIN_PATH")))
(allow file-read* (literal (param "BIN_PATH")))
(allow process-fork)

; dyld, libSystem, MuPDF and every Homebrew dylib libmupdf.dylib links
; (`otool -L` lists them). These paths hold system and library files, never the
; untrusted PDF, and the allowance is read-only.
(allow file-read*
    (subpath "/usr/lib")
    (subpath "/System/Library")
    (subpath "/private/var/db/dyld")
    (subpath "/opt/homebrew"))
(allow file-read-metadata (subpath "/private/var/db/timezone"))
(allow file-read* (literal "/private/etc/localtime"))
(allow sysctl-read)
(allow mach-lookup)

; The untrusted input: read-only.
(allow file-read* (literal (param "IN_PATH")))

; t4_replace creates the output, reopens it for the residual scan, and deletes
; it on any failure (discard_output in task4pdf.c). No other path is created,
; written or removed.
(allow file-read* file-write* (literal (param "OUT_PATH")))
