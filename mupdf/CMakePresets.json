{
  "version": 6,
  "configurePresets": [
    {
      "name": "mupdf",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/mupdf-build",
      "cacheVariables": {
        "MUPDF_PREFIX": "${sourceDir}/../build/mupdf",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "27.0"
      }
    }
  ],
  "buildPresets": [{ "name": "mupdf", "configurePreset": "mupdf" }],
  "workflowPresets": [
    {
      "name": "mupdf",
      "steps": [
        { "type": "configure", "name": "mupdf" },
        { "type": "build", "name": "mupdf" }
      ]
    }
  ]
}
